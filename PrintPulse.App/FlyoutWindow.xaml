<Window x:Class="PrintPulse.FlyoutWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PrintPulse" Width="510" Height="560" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" Background="#EDF3F9">
 <Border Background="#EDF3F9" BorderBrush="#CFD9E4" BorderThickness="1" CornerRadius="10" Padding="13">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="6,3,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#0067C0" CornerRadius="7" Width="32" Height="32" Margin="0,0,11,0"><TextBlock Text="∿" Foreground="White" FontSize="30" HorizontalAlignment="Center" Margin="0,-6,0,0"/></Border><TextBlock Text="PrintPulse" FontSize="20" VerticalAlignment="Center"/></StackPanel>
    <Button Grid.Column="1" Content="↻" FontSize="20" Padding="9,0" ToolTip="Refresh" AutomationProperties.Name="Refresh" Click="RefreshClick"/>
    <Button Grid.Column="2" Content="⚙" FontSize="18" Padding="9,0" ToolTip="Settings" AutomationProperties.Name="Settings" Click="SettingsClick"/>
   </Grid>
   <TextBlock Grid.Row="1" Text="{Binding ConnectionText}" Foreground="#5C6570" TextWrapping="Wrap" FontSize="12" Margin="6,0,6,12"/>
   <ScrollViewer x:Name="PrinterScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
    <ItemsControl x:Name="PrinterItems" ItemsSource="{Binding VisiblePrinters}">
     <ItemsControl.ItemTemplate><DataTemplate>
      <Border Background="#FBFCFE" CornerRadius="12" Padding="16,13,16,14" Margin="0,0,0,10">
       <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="76"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontSize="15" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Margin="0,0,10,0"/><TextBlock Grid.Column="1" Text="{Binding JobLabel}" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip="{Binding JobLabel}"/></Grid>
        <Grid Grid.Row="1" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Grid Margin="0,0,14,0"><Border CornerRadius="8" Background="#F0F3F6"><Path Data="M 25,6 L 45,17 L 45,41 L 25,53 L 5,41 L 5,17 Z M 5,17 L 25,29 L 45,17 M 25,29 L 25,53 M 25,6 L 25,17" Stroke="#8998A7" StrokeThickness="1.6" Stretch="Uniform" Width="39" Height="46"/></Border><Image Source="{Binding Thumbnail}" Stretch="Uniform"><Image.Style><Style TargetType="Image"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Image.Style></Image></Grid>
         <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="{Binding Percentage}" Foreground="{Binding Accent}" FontSize="27" FontWeight="SemiBold" Margin="0,-6,0,0"/><TextBlock Text="{Binding StateLabel}" Foreground="{Binding Accent}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="13" ToolTip="{Binding Freshness}"/>
          <ProgressBar Grid.Row="1" Value="{Binding BarValue, Mode=OneWay}" Maximum="100" Foreground="{Binding Accent}" Background="#DFE5EE" BorderThickness="0" Height="7"><ProgressBar.Template><ControlTemplate TargetType="ProgressBar"><Grid x:Name="PART_Track"><Border Background="{TemplateBinding Background}" CornerRadius="4"/><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4" HorizontalAlignment="Left"/></Grid></ControlTemplate></ProgressBar.Template></ProgressBar>
          <Grid Grid.Row="2" Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding LayerLabel}" FontSize="12" Foreground="#646A74"/><Border Grid.Column="1" BorderBrush="#CFD4DE" BorderThickness="1,0,0,0" Padding="8,0"><TextBlock Text="{Binding TimeLabel}" FontSize="12" Foreground="#646A74"/></Border><Border Grid.Column="2" BorderBrush="#CFD4DE" BorderThickness="1,0,0,0" Padding="8,0,0,0"><TextBlock Text="{Binding EtaLabel}" FontSize="12" Foreground="#646A74"/></Border></Grid>
         </Grid>
        </Grid>
       </Grid>
      </Border>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </ScrollViewer>
   <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding VisiblePrinters.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="Your printers, at a glance" FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="Sign in to Bambu Lab in Settings.&#10;All your visible printers will appear here." TextAlignment="Center" Foreground="#626C77" Margin="0,12"/><Button Content="Open Settings" Click="SettingsClick" HorizontalAlignment="Center"/></StackPanel>
   <TextBlock Grid.Row="3" Text="Printer updates arrive automatically" Foreground="#697684" FontSize="11" Margin="6,2,0,0"/>
  </Grid>
 </Border>
</Window>


